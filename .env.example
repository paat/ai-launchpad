# Reference only: supply these through the launching environment.
# Never commit real credentials. No dotenv loader is installed.
PORT=3000
NODE_ENV=development
# Explicit local synthetic login; always ignored in production.
LAUNCHPAD_DEMO=0
LAUNCHPAD_DB_PATH=./data/launchpad.db
# Exact canonical scheme, hostname and port; aliases are rejected.
LAUNCHPAD_BASE_URL=http://localhost:3000
LAUNCHPAD_ALLOWED_HOSTS=localhost,127.0.0.1
# Opt-in only, default off (0). Set to 1 only when a local Caddy hop 0
# (exact loopback 127.0.0.1/::1) overwrites/sanitizes X-Forwarded-For
# before it reaches this app. The app trusts only that exact loopback
# hop 0, never blanket proxy trust, and cannot by itself verify that a
# Cloudflare (or any upstream) header is genuine.
LAUNCHPAD_TRUST_LOOPBACK_PROXY=0
# Empty means no verified release identity: /health reports
# release_sha: null. When set, it must be the exact verified-manifest
# value of exactly 40 lowercase hex characters; any other value makes
# the app refuse to start.
LAUNCHPAD_RELEASE_SHA=
# Optional identity-only Google sign-in. Callback must match base URL exactly:
# http://localhost:3000/auth/callback/google. No Gmail or Calendar scopes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Owner-only pilot allowlist (REQUIRED in production; the server refuses to
# start without it there). Comma-separated exact opaque Google subject (sub)
# values, at most 20, each 1-255 chars, no spaces. NEVER email addresses.
# Supply the real value privately through the launching environment only;
# never commit it. When set it is enforced in any environment; when omitted
# in local development the existing local demo behavior is unchanged.
#LAUNCHPAD_GOOGLE_ALLOWED_SUBJECTS=opaque-google-subject-1,opaque-google-subject-2
# test = saved deterministic fixtures; disabled = no model jobs.
# Live Baseten/Meta inference is hard-disabled, regardless of keys or budgets.
MODEL_MODE=test
