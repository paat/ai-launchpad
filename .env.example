# Reference only: supply these through the launching environment.
# Never commit real credentials. No dotenv loader is installed.
PORT=3000
NODE_ENV=development
# Explicit local synthetic login; always ignored in production.
LAUNCHPAD_DEMO=0
LAUNCHPAD_DB_PATH=./data/launchpad.db
# Exact canonical scheme, hostname and port; aliases are rejected.
LAUNCHPAD_BASE_URL=http://localhost:3000
LAUNCHPAD_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional identity-only Google sign-in. Callback must match base URL exactly:
# http://localhost:3000/auth/callback/google. No Gmail or Calendar scopes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# test = saved deterministic fixtures; disabled = no model jobs.
# Live Baseten/Meta inference is hard-disabled, regardless of keys or budgets.
MODEL_MODE=test
