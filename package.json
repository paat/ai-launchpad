{
  "name": "ai-launchpad",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "LAUNCHPAD_DEMO=1 NODE_ENV=development tsx src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:browser": "playwright test && node --import tsx tests/onboarding-copy.browser.mjs && node --import tsx tests/ui-redesign.browser.mjs",
    "test:probes": "npm run build && node tests/review-probes.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.2",
    "openid-client": "^6.3.3",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/qrcode": "1.5.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
