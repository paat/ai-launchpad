# Installed by root as /etc/launchpad/launchpad.env, mode 0600, owner
# root:launchpad (readable by the service only). Never commit a filled copy.
NODE_ENV=production
PORT=4310
# Synthetic demo login must stay off in production (the app also ignores it
# when NODE_ENV=production; both gates are kept deliberately).
LAUNCHPAD_DEMO=0
LAUNCHPAD_DB_PATH=/var/lib/launchpad/launchpad.db
LAUNCHPAD_BASE_URL=https://huppelaud.arikratt.ee
LAUNCHPAD_ALLOWED_HOSTS=huppelaud.arikratt.ee
# Private default stays disabled forever: NEVER flip this global value.
# The per-release manifest-bound release.env (loaded after this file)
# carries the committed deploy/release-mode policy for that release and
# overrides MODEL_MODE only for that release.
MODEL_MODE=disabled
# Public-cards prerequisites (empty placeholders only in this example;
# real values, if ever provisioned, live only in the private file).
BASETEN_API_KEY=
LAUNCHPAD_MODEL_LEDGER_PATH=
LAUNCHPAD_MODEL_PRICING_CONFIRMED=
# Identity-only Google sign-in (optional; leave empty until provisioned).
# Callback registered in Google must be exactly:
# https://huppelaud.arikratt.ee/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# REQUIRED pilot allowlist: comma-separated exact opaque Google `sub`
# values (never email addresses). Missing/empty fails startup. The
# operator supplies real values only in the private installed env file;
# leave this public placeholder empty. Google's app "Testing" status is
# not an access control — this allowlist is. Identity-only scopes remain.
LAUNCHPAD_GOOGLE_ALLOWED_SUBJECTS=
# Trusted proxy: trust X-Forwarded-For ONLY from the loopback Caddy proxy,
# which overwrites it with the Cloudflare CF-Connecting-IP header (see
# deploy/caddy/*). Keep 0/unset everywhere except behind that exact proxy.
LAUNCHPAD_TRUST_LOOPBACK_PROXY=1
# LAUNCHPAD_RELEASE_SHA is NEVER set here: it comes only from the
# manifest-bound /opt/launchpad/current/release.env (see unit file).
# Backup destination: off-host copies are PULLED from /var/backups/launchpad
# by the backup operator; there is intentionally no push/off-host command.
