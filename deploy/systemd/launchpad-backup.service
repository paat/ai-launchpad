# Operator-installed, root-owned. deploy-backup.mjs is installed once under
# /usr/local/lib/launchpad/ (NOT inside a release dir) so a release cannot
# replace the backup tool. Runs AS launchpad (never root): read/write on
# the DB directory (WAL-consistent online backup needs the -shm/-wal dir)
# and write on /var/backups/launchpad only. Started by the daily timer and,
# before every non-bootstrap deploy, by deploy-host.sh via the one fixed
# sudo grant `systemctl start launchpad-backup.service`.
# Pin the Node path as in launchpad.service: /usr/bin/node (Node 22.23.3,
# confirmed production pin).
[Unit]
Description=AI Launchpad SQLite online backup
After=network.target

[Service]
Type=oneshot
User=launchpad
Group=launchpad
EnvironmentFile=/etc/launchpad/launchpad.env
Environment=LAUNCHPAD_CURRENT=/opt/launchpad/current
Environment=LAUNCHPAD_BACKUP_DIR=/var/backups/launchpad
ExecStart=/usr/bin/node /usr/local/lib/launchpad/deploy-backup.mjs backup
# /var/backups/launchpad is operator-precreated launchpad:launchpad-backups
# mode 2750 (setgid): snapshots inherit that group so the separate backup
# operator can read completed files. The tool also chmods 0640 the
# verified snapshot and sidecar explicitly.
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/launchpad /var/backups/launchpad
MemoryMax=256M
CPUQuota=25%
TasksMax=32
